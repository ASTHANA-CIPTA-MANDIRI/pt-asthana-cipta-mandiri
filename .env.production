# Dipakai otomatis oleh `npm run build` (mode production) — ikut repo.
# Alamat situs: sitemap.xml, URL kanonik, hreflang, og:url/og:image.
VITE_SITE_URL=https://asthanaciptamandiri.com

# VITE_API_URL (alamat API lemon/Phoenix produksi) TETAP diisi di .env
# di mesin yang membangun — tidak ditaruh di sini.

# Folder situs di peladen produksi (Hostinger: public_html/asthana, akar domain
# dialihkan ke sana). Dipakai untuk jalur halaman 404 di .htaccess hasil build.
VITE_FOLDER_PELADEN=/asthana
